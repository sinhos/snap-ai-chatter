# ── Gemini (free tier) ──────────────────────────────────────────────
# Crea una chiave gratis su https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Scegli un modello attualmente disponibile in Google AI Studio.
# Nessun default: disponibilità e quote dipendono dal modello e dall'account.
GEMINI_MODEL=

# ── Imbuto → Telegram ───────────────────────────────────────────────
# Il link verso cui l'AI indirizza gli amici (gruppo/canale Telegram).
TELEGRAM_LINK=

# ── Chi può ricevere risposte automatiche ───────────────────────────
# Vuoto = nessuna conversazione; obbligatoria per --send.
# Metti i nomi/username degli amici separati da virgola: il bot risponde
# SOLO a queste conversazioni. Confronto esatto, case-insensitive.
WHITELIST=
# Persone da non toccare MAI (vince sulla whitelist).
BLACKLIST=

# ── Comportamento ───────────────────────────────────────────────────
# Ogni quanti secondi ricontrolla le chat
POLL_INTERVAL_SECONDS=60
# Massimo risposte per ciclo (kill-switch anti-spam / anti-ban)
MAX_REPLIES_PER_CYCLE=3
# Ritardo "umano" prima di inviare una risposta (secondi, min-max)
REPLY_DELAY_MIN=4
REPLY_DELAY_MAX=14

# ── Throttle anti-ban / anti-quota (utile se hai TANTI amici) ────────
# Tetto TOTALE di messaggi al giorno (0 = nessun limite). Protegge insieme
# il rischio ban e la quota giornaliera gratis di Gemini.
MAX_MESSAGES_PER_DAY=40
# Fascia oraria in cui il bot è attivo (0-24). Fuori da qui aspetta, non scrive.
ACTIVE_HOURS_START=10
ACTIVE_HOURS_END=22
# Ondate: contatta solo WAVE_SIZE amici della whitelist alla volta, poi ruota
# al gruppo successivo ogni WAVE_MINUTES. Così non li tocchi tutti insieme.
# 0 = disattivato (tutta la whitelist insieme).
WAVE_SIZE=15
WAVE_MINUTES=30

# ── Browser ─────────────────────────────────────────────────────────
# Vuoto usa il Chromium installato con Playwright; chrome usa Google Chrome.
BROWSER_CHANNEL=
